# Copie este arquivo para .env e preencha com valores reais.
# NUNCA cometa o arquivo .env com valores reais no controle de versão.

# Banco de dados Postgres (ex.: Vercel Postgres / Neon)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Instagram Graph API
# Token de acesso de longa duração de uma conta comercial do Instagram
# vinculada a um App do Meta for Developers.
META_ACCESS_TOKEN=

# ID da conta comercial do Instagram (Instagram Business Account ID)
IG_USER_ID=

# Segredo usado para autenticar chamadas ao endpoint de cron
# (Authorization: Bearer <CRON_SECRET>). Gere um valor aleatório forte.
CRON_SECRET=
